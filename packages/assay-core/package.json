{
  "name": "assay-core",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./schemas": "./dist/schemas/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "templates"],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "test:serial": "vitest run --config vitest.config.ts --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "assay-test-support": "workspace:*"
  },
  "dependencies": {
    "execa": "^9.5.0",
    "fs-extra": "^11.2.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
